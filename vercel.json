{
  "version": 2,
  "public": true,
  "routes": [
    {
      "src": "/privacy-policy.html",
      "dest": "/privacy-policy.html"
    },
    {
      "src": "/terms-of-use.html",
      "dest": "/terms-of-use.html"
    },
    {
      "src": "/refund-policy.html",
      "dest": "/refund-policy.html"
    },
    {
      "src": "/how-it-works.html",
      "dest": "/how-it-works.html"
    },
    {
      "src": "/trade-director.html",
      "dest": "/trade-director.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.islandbarterexchange.com"
        }
      ],
      "destination": "https://islandbarterexchange.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
